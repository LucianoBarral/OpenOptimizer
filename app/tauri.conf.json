{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Optimizer",
  "version": "0.1.0",
  "identifier": "io.github.lucianobarral.openoptimizer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Optimizer",
        "width": 1180,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#0B0C0E",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "perMachine" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/LucianoBarral/OpenOptimizer/releases/latest/download/latest.json"],
      "pubkey": "PREENCHIDO_NA_TASK_10_STEP_1",
      "windows": { "installMode": "passive" }
    }
  }
}
