{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Optimizer",
  "version": "0.3.0",
  "identifier": "io.github.lucianobarral.openoptimizer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "node scripts/predev.mjs",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "node scripts/prebuild.mjs",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Optimizer",
        "width": 1180,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#0B0C0E",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "externalBin": [
      "binaries/oo-gamingd",
      "binaries/presentmon"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LucianoBarral/OpenOptimizer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QjM2NjZFOTcwMkJEOTEKUldTUnZRS1hibWF6ZHJFR0tpNnVXdFp3Y0I2U1FnM1MvRzlKbDZYb09pWWtNUXhqaVBVOFplUzcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
